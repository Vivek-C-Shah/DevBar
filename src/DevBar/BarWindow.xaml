<Window x:Class="DevBar.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevBar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="Manual">

    <!-- A small floating toolbar, flush to the top edge, centered on screen.
         The Window itself is fixed at the max (expanded) size — animating a
         WPF Window's own Width/Height live is unreliable, the HWND surface can
         lag the layout. Instead only the inner Panel border animates size, and
         WM_NCHITTEST (see WndProc) makes the empty margin around it click-through
         so it never blocks whatever's underneath while idle. -->
    <Border x:Name="Panel" Background="{StaticResource BrushPanelGlass}"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            BorderThickness="1,0,1,1" BorderBrush="{StaticResource BrushHairline}"
            CornerRadius="0,0,10,10" ClipToBounds="True" AllowDrop="True"
            MouseEnter="Panel_MouseEnter" MouseLeave="Panel_MouseLeave"
            DragEnter="Panel_DragEnter">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- "Liquid glass" mesh: three soft, slowly-drifting accent-hued
                 blobs behind everything else, each blurred at radius 24. This
                 is what gives the surface its shifting, organic color — real
                 backdrop blur (GlassEffect.cs) makes the *desktop* behind the
                 bar illegible; this layer is what makes the *bar itself* feel
                 alive. Built from our own accent color, not sampled from live
                 desktop pixels — continuous screen-capture-based color
                 sampling would cost real CPU on every frame, the same tax
                 that made permanent blur-behind a non-starter (see
                 GlassEffect.cs). Animations only run while expanded, same
                 discipline as the blur itself. Skipped entirely when Windows'
                 "Transparency effects" setting is off — see ApplyGlassMode.
                 ClipToBounds="True" on Panel keeps every blob inside the
                 rounded shape. -->
            <Grid x:Name="MeshGradient" Grid.ColumnSpan="2" Opacity="0" IsHitTestVisible="False">
                <Ellipse x:Name="Blob1" Width="230" Height="230" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-60,-90,0,0">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob1Tx"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <BlurEffect Radius="24"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="Blob2" Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-110,-80,0">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob2Tx"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <BlurEffect Radius="24"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="Blob3" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,-100">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Blob3Tx"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <BlurEffect Radius="24"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- left accent rail, fades in together with the expanded content -->
            <Border x:Name="AccentRail" Grid.Column="0" Background="{DynamicResource BrushAccent}" Opacity="0"/>

            <Grid Grid.Column="1">
                <!-- idle mark: small centered accent bar, the only thing visible all day -->
                <Border x:Name="IdleMark" Width="22" Height="3" CornerRadius="1.5"
                        Background="{DynamicResource BrushAccent}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid x:Name="PanelContent" Opacity="0" Margin="12,7,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- header: module identity (left) · pin (right) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ModGlyph" FontFamily="{StaticResource FontGlyph}" FontSize="12"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModName" Margin="8,0,0,0" Style="{StaticResource Overline}"
                                       FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- No ToolTip here on purpose: a tooltip popup is its own top-level
                             window, and it stealing the hover point mid-display would fire a
                             real MouseLeave on the bar and collapse it out from under the user. -->
                        <Button x:Name="PinBtn" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE718;"
                                Width="22" Height="20" Click="PinBtn_Click"/>
                    </Grid>

                    <!-- carousel viewport: one module in focus, full width of the card.
                         Also pages on a touchpad's two-finger horizontal swipe — see
                         WM_MOUSEHWHEEL in WndProc. -->
                    <Grid Grid.Row="1" x:Name="Viewport" ClipToBounds="True" Margin="0,5,0,0"
                          SizeChanged="Viewport_SizeChanged">
                        <StackPanel x:Name="Track" Orientation="Horizontal" HorizontalAlignment="Left">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="TrackTx"/>
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Grid>

                    <!-- bottom nav: prev · dots · next, grouped together so paging
                         controls sit right where your eye already is, not off in a
                         top corner. -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE76B;"
                                Width="22" Height="20" Click="PrevBtn_Click"/>
                        <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="8,0"/>
                        <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE76C;"
                                Width="22" Height="20" Click="NextBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
