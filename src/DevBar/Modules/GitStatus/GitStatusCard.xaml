<UserControl x:Class="DevBar.Modules.GitStatus.GitStatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Border Height="34" Margin="0,0,0,4" Padding="10,0"
                    Background="{StaticResource BrushBgElevated}" CornerRadius="6"
                    Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Row_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushGood}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource BrushWarn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Error}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="9.5" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoMuted}">
                                    <Setter Property="Text" Value="{Binding Branch}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Error}" Value="True">
                                            <Setter Property="Text" Value="not found / not a git repo"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="2" FontSize="10.5"
                               VerticalAlignment="Center" Margin="8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoMuted}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpstream}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="↑"/><Run Text="{Binding Ahead}"/>
                        <Run Text="  ↓"/><Run Text="{Binding Behind}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource FontGlyph}" FontSize="30"
                       Foreground="{StaticResource BrushMuted}" Opacity="0.6" HorizontalAlignment="Center"
                       Text="&#xE7C3;"/>
            <TextBlock Text="No repos watched" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
            <TextBlock Text="add paths to gitWatchedRepos in config.json" Style="{StaticResource BodyMuted}"
                       FontSize="10.5" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ThinScrollViewer}" Padding="0,0,0,8">
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource RowTemplate}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
