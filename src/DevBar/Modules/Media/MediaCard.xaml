<UserControl x:Class="DevBar.Modules.Media.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock x:Name="EmptyHint" Text="Nothing playing." Style="{StaticResource BodyMuted}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <StackPanel x:Name="PlayerPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Border Width="90" Height="90" CornerRadius="8" ClipToBounds="True"
                    Background="{StaticResource BrushBgElevated}">
                <Image x:Name="Thumb" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="220">
                <TextBlock Style="{StaticResource Overline}" Text="Now Playing"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"
                           Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Style="{StaticResource BodyMuted}" TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" Click="Play_Click" Margin="4,0"/>
                    <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
