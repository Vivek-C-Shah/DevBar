<UserControl x:Class="DevBar.Modules.Docker.DockerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Border Height="34" Margin="0,0,0,4" Padding="10,0"
                    Background="{StaticResource BrushBgElevated}" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource BrushGood}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Image}" Style="{StaticResource MonoMuted}" FontSize="9.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource BodyMuted}"
                               FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="3" Width="24" Height="22"
                            Tag="{Binding}" Click="Toggle_Click" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE768;"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="&#xE71A;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- distinct empty states - "nothing running" reads very differently
             from "Docker isn't even installed", so they're not allowed to
             look the same. -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyGlyph" FontFamily="{StaticResource FontGlyph}" FontSize="30"
                       Foreground="{StaticResource BrushMuted}" Opacity="0.6" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
            <TextBlock x:Name="EmptySubtitle" Style="{StaticResource BodyMuted}" FontSize="10.5" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ThinScrollViewer}" Padding="0,0,0,8">
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource RowTemplate}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
