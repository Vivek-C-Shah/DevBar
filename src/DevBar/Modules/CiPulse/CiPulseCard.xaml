<UserControl x:Class="DevBar.Modules.CiPulse.CiPulseCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TargetTemplate">
            <Border Width="150" Height="90" Margin="0,0,8,0" Padding="12"
                    Background="{StaticResource BrushBgElevated}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{StaticResource BrushHairline}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Ellipse Grid.Row="0" Width="9" Height="9" HorizontalAlignment="Left">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Success">
                                        <Setter Property="Fill" Value="{StaticResource BrushGood}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource Body}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" FontSize="9.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
                                <Setter Property="Text" Value="no recent build"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Success">
                                        <Setter Property="Text" Value="built recently"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource FontGlyph}" FontSize="30"
                       Foreground="{StaticResource BrushMuted}" Opacity="0.6" HorizontalAlignment="Center"
                       Text="&#xE73E;"/>
            <TextBlock Text="No build targets watched" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
            <TextBlock Text="add entries to ciWatchTargets in config.json" Style="{StaticResource BodyMuted}"
                       FontSize="10.5" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ThinScrollViewer}">
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource TargetTemplate}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
