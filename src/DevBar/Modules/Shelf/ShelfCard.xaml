<UserControl x:Class="DevBar.Modules.Shelf.ShelfCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragEnter="Card_DragEnter" DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemTemplate">
            <Border Width="96" Height="96" Margin="0,0,8,0" Padding="10"
                    Background="{StaticResource BrushBgElevated}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{StaticResource BrushHairline}"
                    Cursor="Hand" Tag="{Binding}"
                    MouseLeftButtonDown="Item_MouseLeftButtonDown"
                    MouseMove="Item_MouseMove">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontFamily="{StaticResource FontGlyph}" FontSize="26"
                               Foreground="{DynamicResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="&#xE7C3;"/>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource BodyMuted}"
                               FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               HorizontalAlignment="Stretch"/>
                    <Button Grid.Row="0" Content="&#xE711;" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="9"
                            Click="Remove_Click" Tag="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="DropHint" Background="{DynamicResource BrushAccentDim}" CornerRadius="8"
                BorderThickness="1.5" BorderBrush="{DynamicResource BrushAccent}"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="Drop to shelve" Style="{StaticResource Body}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock x:Name="EmptyHint" Text="Drag files or images in — cleared on restart."
                   Style="{StaticResource BodyMuted}" HorizontalAlignment="Left" VerticalAlignment="Top"
                   IsHitTestVisible="False"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ThinScrollViewer}">
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource ItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
