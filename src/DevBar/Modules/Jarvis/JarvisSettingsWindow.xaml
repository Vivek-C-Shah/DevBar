<Window x:Class="DevBar.Modules.Jarvis.JarvisSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis settings" Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BrushBg}"
        BorderBrush="{StaticResource BrushHairline}" BorderThickness="1">

    <Window.Resources>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="{StaticResource BrushBgElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}"/>
        </Style>

        <!-- segmented choice chips -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushHairline}"
                                BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <ContentPresenter TextElement.Foreground="{StaticResource BrushMuted}"
                                              TextElement.FontFamily="{StaticResource FontUi}" TextElement.FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushMuted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- on/off chip, same look as Seg -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushHairline}"
                                BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Tick" Text="&#xE739;" FontFamily="{StaticResource FontGlyph}" FontSize="11"
                                           Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <ContentPresenter TextElement.Foreground="{StaticResource BrushMuted}"
                                                  TextElement.FontFamily="{StaticResource FontUi}" TextElement.FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushMuted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="Tick" Property="Text" Value="&#xE73A;"/>
                                <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Style="{StaticResource ThinScrollViewer}">
    <StackPanel Margin="20,14,20,18">
        <Grid x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE720;" FontFamily="{StaticResource FontGlyph}" Foreground="{DynamicResource BrushAccent}"
                           FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="Jarvis settings" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>

        <!-- shortcut -->
        <TextBlock Style="{StaticResource Section}" Text="Shortcut — press to talk, press again to stop"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                     GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
            <Button Grid.Column="1" Style="{StaticResource ChipButton}" Margin="8,0,0,0" Click="ApplyHotkey_Click">
                <TextBlock Text="Apply" Style="{StaticResource Body}"/>
            </Button>
        </Grid>
        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource BodyMuted}" FontSize="11" Margin="0,4,0,0"
                   Text="Click the box, then press the new combination."/>

        <!-- you -->
        <TextBlock Style="{StaticResource Section}" Text="You"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Call me" Style="{StaticResource Body}" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Column="1" FontFamily="{StaticResource FontUi}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Text="Home" Style="{StaticResource Body}" VerticalAlignment="Center"/>
            <TextBox x:Name="HomeBox" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource FontUi}" Margin="0,0,0,6"
                     ToolTip="e.g. Pune, India. Leave empty to detect automatically."/>
        </Grid>
        <TextBlock x:Name="LocationStatus" Style="{StaticResource BodyMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <WrapPanel>
            <CheckBox x:Name="UseLocationBox" Style="{StaticResource Toggle}" Content="Know my location"/>
            <CheckBox x:Name="LearnBox" Style="{StaticResource Toggle}" Content="Learn about me"/>
            <CheckBox x:Name="BargeInBox" Style="{StaticResource Toggle}" Content="Interrupt by talking"/>
        </WrapPanel>
        <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Click="Memory_Click">
            <TextBlock Text="What Jarvis knows about you..." Style="{StaticResource Body}"/>
        </Button>

        <!-- wake word -->
        <TextBlock Style="{StaticResource Section}" Text="Wake word"/>
        <WrapPanel>
            <CheckBox x:Name="WakeBox" Style="{StaticResource Toggle}" Content="Say &quot;Hey Jarvis&quot;" Click="WakeBox_Click"/>
            <CheckBox x:Name="WakeBatteryBox" Style="{StaticResource Toggle}" Content="Also on battery"/>
        </WrapPanel>
        <TextBlock x:Name="WakeStatus" Style="{StaticResource BodyMuted}" FontSize="11" TextWrapping="Wrap"
                   Text="Keeps the mic open while idle, on-device only (~0.3% CPU); nothing leaves your PC until you say it. The bar's idle mark turns green while it listens."/>

        <!-- heads-ups -->
        <TextBlock Style="{StaticResource Section}" Text="Heads-ups: Jarvis speaks up on its own"/>
        <WrapPanel>
            <RadioButton x:Name="ProactiveSpeak" GroupName="proactive" Style="{StaticResource Seg}" Content="Speak"/>
            <RadioButton x:Name="ProactiveShow" GroupName="proactive" Style="{StaticResource Seg}" Content="Show only"/>
            <RadioButton x:Name="ProactiveOff" GroupName="proactive" Style="{StaticResource Seg}" Content="Off"/>
        </WrapPanel>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Quiet hours" Style="{StaticResource Body}" VerticalAlignment="Center"/>
            <TextBox x:Name="QuietBox" Grid.Column="1" ToolTip="HH:mm-HH:mm, e.g. 23:00-08:00. Notices still show, silently. Empty = never quiet."/>
        </Grid>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ClaudeHookBtn" Style="{StaticResource ChipButton}" Click="ClaudeHook_Click">
                <TextBlock x:Name="ClaudeHookText" Style="{StaticResource Body}"/>
            </Button>
            <TextBlock x:Name="ClaudeHookStatus" Style="{StaticResource BodyMuted}" FontSize="11" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250"/>
        </StackPanel>
        <TextBlock Style="{StaticResource BodyMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Adds a small hook to ~/.claude/settings.json (backed up first) so I can tell you when a Claude Code session needs you or finishes."/>

        <!-- voice -->
        <TextBlock Style="{StaticResource Section}" Text="Voice"/>
        <WrapPanel>
            <RadioButton x:Name="EngineAura" GroupName="engine" Style="{StaticResource Seg}" Checked="Engine_Checked" Content="Aura-2 · cloud"/>
            <RadioButton x:Name="EnginePiper" GroupName="engine" Style="{StaticResource Seg}" Checked="Engine_Checked" Content="Piper · local"/>
            <RadioButton x:Name="EngineKokoro" GroupName="engine" Style="{StaticResource Seg}" Checked="Engine_Checked" Content="Kokoro · local"/>
            <RadioButton x:Name="EngineWindows" GroupName="engine" Style="{StaticResource Seg}" Checked="Engine_Checked" Content="Windows"/>
        </WrapPanel>
        <WrapPanel x:Name="VoicePanel" Margin="0,2,0,0"/>
        <TextBlock x:Name="EngineNote" Style="{StaticResource BodyMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <StackPanel x:Name="LocalPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,2">
            <Button x:Name="LocalDownloadBtn" Style="{StaticResource ChipButton}" Click="LocalDownload_Click">
                <TextBlock x:Name="LocalDownloadText" Style="{StaticResource Body}"/>
            </Button>
            <TextBlock x:Name="LocalStatus" Style="{StaticResource BodyMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="TestVoiceBtn" Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="TestVoice_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource FontGlyph}" FontSize="11" Foreground="{StaticResource BrushText}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Test voice" Style="{StaticResource Body}" Margin="6,0,0,0"/>
            </StackPanel>
        </Button>

        <!-- keys -->
        <TextBlock Style="{StaticResource Section}" Text="API keys — stored encrypted for your Windows account"/>
        <Grid x:Name="KeysGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock Style="{StaticResource BodyMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
            <Run Text="Brain order (first that answers wins):"/>
            <Run x:Name="BrainChain" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushText}"/>
            <LineBreak/><Run Text="Edit the order in config.json → Jarvis.Llm."/>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock x:Name="SavedText" Style="{StaticResource BodyMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Style="{StaticResource ChipButton}" Click="Close_Click">
                <TextBlock Text="Close" Style="{StaticResource Body}"/>
            </Button>
            <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0" Click="Save_Click">
                <TextBlock Text="Save" Style="{StaticResource Body}" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
