<Window x:Class="DevBar.Modules.Jarvis.JarvisMemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What Jarvis knows" Width="520" Height="560"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BrushBg}"
        BorderBrush="{StaticResource BrushHairline}" BorderThickness="1">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushBgElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource FontGlyph}" Foreground="{DynamicResource BrushAccent}"
                           FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="What Jarvis knows about you" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <TextBlock x:Name="LocationText" Style="{StaticResource BodyMuted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CountText" Style="{StaticResource Overline}" Margin="0,12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Style="{StaticResource ThinScrollViewer}">
            <StackPanel x:Name="FactList"/>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewFactBox" KeyDown="NewFactBox_KeyDown"/>
            <Button Grid.Column="1" Style="{StaticResource ChipButton}" Margin="8,0,0,0" Click="Add_Click">
                <TextBlock Text="Add" Style="{StaticResource Body}"/>
            </Button>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource BodyMuted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,150,0"
                       Text="Stored only on this PC (jarvis.db). The most recent facts are shared with the AI brain so it can use them."/>
            <Button x:Name="ForgetAllBtn" Style="{StaticResource ChipButton}" HorizontalAlignment="Right" Click="ForgetAll_Click">
                <TextBlock x:Name="ForgetAllText" Text="Forget everything" Style="{StaticResource Body}" Foreground="{StaticResource BrushDanger}"/>
            </Button>
        </Grid>
    </Grid>
</Window>
