<UserControl x:Class="DevBar.Modules.Jarvis.JarvisCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,2,4,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The orb: flat rings only (style lock — no gradients/shadows).
             Halo scales with mic level while listening and with Jarvis's
             own voice while speaking; Core breathes while thinking. Every
             animation here runs only during a live session. -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="104" Height="104" HorizontalAlignment="Center">
                <Ellipse x:Name="Halo" Width="96" Height="96" StrokeThickness="1.5"
                         Stroke="{DynamicResource BrushAccent}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="HaloScale" ScaleX="0.8" ScaleY="0.8"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Ring" Width="64" Height="64" StrokeThickness="2"
                         Stroke="{DynamicResource BrushAccent}" Opacity="0.6"/>
                <Ellipse x:Name="Core" Width="40" Height="40" Fill="{DynamicResource BrushAccent}"
                         Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CoreScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="MicGlyph" Text="&#xE720;" FontFamily="{StaticResource FontGlyph}" FontSize="16"
                           Foreground="{StaticResource BrushText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="StatusText" Style="{StaticResource Overline}" Text="Ready"
                       HorizontalAlignment="Center" Margin="0,10,0,2" FontSize="11"/>
            <TextBlock x:Name="HotkeyText" Style="{StaticResource MonoMuted}" FontSize="10.5"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="WakeText" Style="{StaticResource MonoMuted}" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,3,0,0" TextAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- what you said -->
            <Grid Grid.Row="0">
                <TextBlock Style="{StaticResource Overline}" Text="You" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ForgetBtn" Style="{StaticResource IconButton}" Content="&#xE894;" Width="22" Height="20"
                            Click="Forget_Click"/>
                    <Button x:Name="MemoryBtn" Style="{StaticResource IconButton}" Content="&#xE77B;" Width="22" Height="20"
                            Margin="2,0,0,0" Click="Memory_Click"/>
                    <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" Content="&#xE713;" Width="22" Height="20"
                            Margin="2,0,0,0" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="HeardText" Grid.Row="1" Style="{StaticResource BodyMuted}" FontSize="12.5"
                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,3,0,8"/>

            <!-- what Jarvis said -->
            <ScrollViewer x:Name="ReplyScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden" Focusable="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Text="Jarvis"/>
                    <TextBlock x:Name="ReplyText" Style="{StaticResource Body}" FontSize="13.5" LineHeight="19"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- tool chips, confirmation, problems -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <WrapPanel x:Name="Chips"/>
                <StackPanel x:Name="ConfirmPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                    <Button Style="{StaticResource ChipButton}" Click="ConfirmYes_Click">
                        <TextBlock Text="Yes, do it" Style="{StaticResource Body}" Foreground="{StaticResource BrushDanger}"/>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Margin="6,0,0,0" Click="ConfirmNo_Click">
                        <TextBlock Text="Cancel" Style="{StaticResource Body}"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="ProblemText" Style="{StaticResource Body}" Foreground="{StaticResource BrushWarn}"
                           TextWrapping="Wrap" FontSize="11.5" Visibility="Collapsed" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
