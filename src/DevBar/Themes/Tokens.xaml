<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Locked palette — see .tastemaker/style-lock.md. Flat only: no gradients, no shadows. -->
    <Color x:Key="ColBg">#0B0E14</Color>
    <Color x:Key="ColBgElevated">#141926</Color>
    <Color x:Key="ColHairline">#232B3B</Color>
    <Color x:Key="ColText">#DCE3EC</Color>
    <Color x:Key="ColMuted">#8B94A3</Color>
    <Color x:Key="ColGood">#3FB950</Color>
    <Color x:Key="ColWarn">#D29922</Color>
    <Color x:Key="ColDanger">#F47067</Color>

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColBg}"/>
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColBgElevated}"/>
    <SolidColorBrush x:Key="BrushHairline" Color="{StaticResource ColHairline}"/>
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}"/>
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColMuted}"/>
    <SolidColorBrush x:Key="BrushGood" Color="{StaticResource ColGood}"/>
    <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource ColWarn}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColDanger}"/>
    <SolidColorBrush x:Key="BrushHover" Color="#FFFFFF" Opacity="0.07"/>

    <!-- BrushAccent / BrushAccentDim are injected at startup from the Windows accent color
         (App.xaml.cs), so they live in Application.Resources, not here. A fallback is
         declared so the designer and any early lookup never crash. -->
    <SolidColorBrush x:Key="BrushAccent" Color="#5EA1FF"/>
    <SolidColorBrush x:Key="BrushAccentDim" Color="#5EA1FF" Opacity="0.35"/>

    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontGlyph">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="BodyMuted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="MonoMuted" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
    </Style>

</ResourceDictionary>
